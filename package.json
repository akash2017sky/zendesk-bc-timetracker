{
  "name": "zendesk-bc-timetracker",
  "version": "1.0.0",
  "description": "Zendesk Support sidebar app for tracking time and logging entries to Microsoft Dynamics 365 Business Central",
  "main": "index.js",
  "scripts": {
    "dev": "webpack --config webpack.config.dev.js --watch",
    "build": "webpack --config webpack.config.prod.js",
    "package": "zcli apps:package",
    "package:clean": "npm run build && node scripts/package.js",
    "server": "zcli apps:server"
